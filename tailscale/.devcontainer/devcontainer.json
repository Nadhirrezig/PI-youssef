{
  "name": "DevContainer - Tailscale",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "forwardPorts": [3000],
  "postCreateCommand": "cd /workspace/demo-app && npm install",
  "postStartCommand": "cd /workspace/demo-app && TUNNEL_TYPE=tailscale npm start",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
